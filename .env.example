# NextBody Web — local / Vercel env (Phase 1)

# Public site URL (SEO / absolute links)
NEXT_PUBLIC_SITE_URL=https://nexbodyfit.com

# WhatsApp Business number in E.164 (digits with country code). Overrides site-config default.
# Example UAE: +971501234567
NEXT_PUBLIC_WHATSAPP_NUMBER=+971000000000

# Resend — required for real inquiry emails in production
# Get key: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Sender and inquiry recipient both use content/site-settings.json contactEmail:
# info@nexbodyfit.com (mailbox must exist; verify nexbodyfit.com in Resend).
# Legacy EMAIL_FROM / EMAIL_TO variables are ignored.
